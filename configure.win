#!/usr/bin/env sh
# Rscript.exe, and R_ARCH_BIN: R invokes this through sh, where the bare
# "Rscript" name does not resolve on Windows.
#
# tools/config.R runs first: it refuses a missing or too-old Rust toolchain, and
# doing that before tools/vendor.R means such an install fails in milliseconds
# rather than after an 11 MB download it could never use.
: "${R_HOME=`R RHOME`}"
"${R_HOME}/bin${R_ARCH_BIN}/Rscript.exe" tools/config.R || exit 1
"${R_HOME}/bin${R_ARCH_BIN}/Rscript.exe" tools/vendor.R || exit 1
